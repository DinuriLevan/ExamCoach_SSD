    {
      "name": "Finding 1 - Unauthenticated Quiz CRUD (A01)",
      "description": "SECURITY_AUDIT.md Finding 1. No account, no token, no cookie is sent on any request in this folder.",
      "item": [
        {
          "name": "1.1 Create Quiz (No Auth)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "",
                  "pm.test('VULNERABLE: quiz created with no Authorization header', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data._id) {",
                  "    pm.environment.set('f1_quizId', json.data._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/quizzes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"F1 - Unauthenticated Create Test\",\n  \"subject\": \"Security Audit\",\n  \"questions\": [\n    {\n      \"question\": \"Is this quiz creatable without login?\",\n      \"options\": [\n        \"Yes\",\n        \"No\"\n      ],\n      \"correctAnswer\": 0\n    }\n  ]\n}",
